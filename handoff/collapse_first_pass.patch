+def _collapse_parts(parts, since, index, reduced=False):
+    """Deterministic LOCAL vertices; the caller applies the rig world origin.
+
+    The derrick folds at its base in deck space, then inherits the deck's
+    pitch and descent. This keeps their shared joint attached throughout.
+    Reduced motion shows the settled wreck immediately, not an upright rig.
+    """
+    p = 1.0 if reduced else clamp(since / COLLAPSE_FRAMES)
+    sink = .9 if reduced else min(.9, max(0.0, since - COLLAPSE_FRAMES) * .003)
+    flip = -1 if index == 2 else 1
+    sp = smooth(p)
+    dp = smooth(min(1.0, p / .72))
+    hinge = DECK_Y + .5
+    drop = (hinge - WRECK_DECK_Y) * p * p
+    legs, deck, derrick = parts
+    leg_verts = _hinge_part(legs, (0, 0, 0), 10 * flip * sp,
+                           3 * flip * sp, 4.0 * p * p, sink)
+    deck_verts = _hinge_part(deck, (0, hinge, 0), 32 * flip * sp,
+                            5 * flip * sp, drop, sink)
+    # Relative tower rotation; compose it with the parent deck transform.
+    # Final combined roll remains 88 degrees, matching the original wreck.
+    relative = _hinge_part(derrick, (0, hinge, .4),
+                           (88 * dp - 32 * sp) * flip, 0, 0, 0)
+    der_verts = _hinge_part(Mesh(verts=relative), (0, hinge, 0),
+                           32 * flip * sp, 5 * flip * sp, drop, sink)
+    return (leg_verts, deck_verts, der_verts), sink
+
+
+def _rig_world_vertices(vertices, index):
+    """Use the same world origin as the baked standing rig and its effects."""
+    x, z = RIGS[index]
+    return [(vx + x, vy, vz + z) for vx, vy, vz in vertices]
 
 
