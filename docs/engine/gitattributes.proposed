# RPE6 Phase 0 line-ending policy (master prompt R14). Copy to /.gitattributes in its own commit.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.mp4 binary
*.npz binary
*.pyc binary
