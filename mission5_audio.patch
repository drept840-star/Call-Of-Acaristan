+"""Mission 5 sound design and cutscene-owned playback.
+
+Procedural stereo assets, no downloads or new runtime dependencies (numpy is
+already used by the engine). Local RNG never advances the gameplay RNG.
+Long stems are prewarmed before the cinematic clock begins. Foley is still
+scheduled by the production player; this object owns its returned channels.
+"""
+from functools import lru_cache
+import io
+import wave
+
+import numpy as np
+
+
+RATE = 22050
+STEMS = ('m5_quay_air', 'm5_shadow_score')
+FOLEY = ('m5_wet_step', 'm5_roof_step', 'm5_sling', 'm5_door', 'm5_door_open',
+         'm5_laser_switch', 'm5_radio_open', 'm5_radio_close')
+
+
+def _wav(pcm):
+    out = io.BytesIO()
+    with wave.open(out, 'wb') as w:
+        w.setnchannels(2)
+        w.setsampwidth(2)
+        w.setframerate(RATE)
+        w.writeframes(np.rint(np.clip(pcm, -.92, .92) * 32767).astype('<i2').tobytes())
+    return out.getvalue()
+
+
+def _smooth(t, a, b):
+    q = np.clip((t - a) / (b - a), 0., 1.)
+    return q * q * (3. - 2. * q)
+
+
+def _fade(t, duration, attack=.02, release=.12):
+    return _smooth(t, 0, attack) * (1 - _smooth(t, duration-release, duration-1/RATE))
+
+
+def _colour(rng, n, hz):
+    # Interpolated random control points: soft low-frequency noise, stable at
+    # this sample rate, without a filter warm-up transient or scipy dependency.
+    step = max(1, round(RATE / hz))
+    x = np.arange(0, n + step, step)
+    return np.interp(np.arange(n), x, rng.normal(0, .5, len(x)))
+
+
+def _duck(t):
+    """Smooth authored dips even if the optional recorded voice is absent."""
+    from missions.m5.finale_script import LINES  # lazy: no mission/config cycle
+    env = np.ones(len(t))
+    for on, off, *_ in LINES:
+        dip = _smooth(t, on/1000-.22, on/1000) * (1-_smooth(t, off/1000, off/1000+.45))
+        env *= 1 - .56 * dip
+    return env
+
+
+@lru_cache(maxsize=2)
+def stem_pcm(name):
+    from missions.m5.finale_script import DURATION_MS
+    n = round(RATE * DURATION_MS / 1000)
+    t = np.arange(n, dtype=np.float64) / RATE
+    rng = np.random.default_rng(51013 if name == STEMS[0] else 51014)
+    edge = _fade(t, DURATION_MS/1000, .65, 1.65)
+    if name == STEMS[0]:
+        pcm = np.zeros((n, 2))
+        # Independent near rain, slow river surge and exposed-roof air.
+        for side in range(2):
+            rain = rng.normal(0, .018, n) + _colour(rng, n, 1700) * .020
+            river = _colour(rng, n, 140) * (.040 + .014*np.sin(2*np.pi*.19*t+side))
+            air = _colour(rng, n, 32) * (.020 + .012*np.sin(2*np.pi*.11*t+side*.8))
+            pcm[:, side] = rain + river + air
+        # Small gutter droplets, staggered in the stereo field, never UI ticks.
+        for onset in (1.8, 4.4, 8.2, 13.8, 17.7, 23.1, 26.6, 31.4):
+            a = round(onset*RATE); length = round(.24*RATE)
+            tt = np.arange(length)/RATE
+            drop = .030*np.sin(2*np.pi*(1850*tt-1200*tt*tt))*np.exp(-tt*36)
+            pan = rng.uniform(.2,.8)
+            pcm[a:a+length,0] += drop*(1-pan)
+            pcm[a:a+length,1] += drop*pan
+        # Perspective: closer/exposed on the rooftop, close down under Vasile.
+        perspective = 1 + .18*_smooth(t, 6.2, 9.6) - .58*_smooth(t, 34.9, 35.4)
+        pcm *= (edge*perspective*(.72+.28*_duck(t)))[:,None]
+    elif name == STEMS[1]:
+        # D2/A2 pedal + bowed upper partials. Tension blooms with the scope,
+        # withholds a triumphant cadence, and releases when the weapon lowers.
+        pcm = np.zeros((n,2))
+        rise = .24 + .76*_smooth(t, 5.2, 9.6)
+        release = 1 - .45*_smooth(t, 29.6, 31.6)
+        for freq, gain in ((73.416,.032),(110.,.012),(146.832,.015),(220.,.008)):
+            for side in range(2):
+                drift = .12*np.sin(2*np.pi*.09*t + side*.55)
+                vibrato = .24*np.sin(2*np.pi*.31*t + side*.7)
+                pcm[:,side] += gain*np.sin(2*np.pi*(freq+side*.075)*t+drift+vibrato)
+        threat = _smooth(t,6.2,9.6)*(1-_smooth(t,29.0,31.6))
+        for side in range(2):
+            # Quiet minor-second beating, not an action trailer braam.
+            pcm[:,side] += .006*threat*np.sin(2*np.pi*(155.563+side*.09)*t)
+            pcm[:,side] += .007*_colour(rng,n,480)*threat
+        # Wide distant metallic bloom on reveal and small unresolved tail.
+        for onset, strength in ((9.6,.014),(31.6,.009),(40.,.018)):
+            q = np.maximum(0,t-onset)
+            e = _smooth(t,onset,onset+.28)*np.exp(-q*.80)
+            for freq in (293.665,440.,622.254):
+                pcm[:,0] += strength*.32*e*np.sin(2*np.pi*freq*q)
+                pcm[:,1] += strength*.32*e*np.sin(2*np.pi*(freq+.23)*q)
+        pcm *= (edge*rise*release*_duck(t))[:,None]
+    else:
+        raise ValueError('Unknown M5 stem: '+name)
+    pcm.setflags(write=False)
+    return pcm
+
+
+def foley_pcm(name):
+    duration = {'m5_wet_step':.45,'m5_roof_step':.48,'m5_sling':.52,
+                'm5_door':1.05,'m5_door_open':.78,'m5_laser_switch':.14,
+                'm5_radio_open':.23,'m5_radio_close':.31}[name]
+    n = round(duration*RATE); t = np.arange(n)/RATE
+    rng = np.random.default_rng(51000 + FOLEY.index(name))
+    noise = rng.normal(0,1,n)
+    low = _colour(rng,n,800)
+    if name in ('m5_wet_step','m5_roof_step'):
+        # Heel body, delayed sole contact; splash vs gritty rooftop texture.
+        body = .29*np.sin(2*np.pi*85*t)*np.exp(-t*38)
+        sole = .14*low*np.exp(-np.maximum(t-.026,0)*30)*(t>=.026)
+        texture = (.11 if name=='m5_wet_step' else .055)*noise*np.exp(-np.maximum(t-.018,0)*24)*(t>=.018)
+        x = body+sole+texture
+    elif name == 'm5_sling':
+        x = .15*low*np.exp(-t*12) + .045*noise*np.exp(-t*25)
+        x += .055*np.sin(2*np.pi*760*t)*np.exp(-np.maximum(t-.095,0)*55)*(t>=.095)
+    elif name == 'm5_door_open':
+        x = .060*low*np.sin(np.pi*t/duration)
+        x += .022*np.sin(2*np.pi*183*t+.9*np.sin(2*np.pi*5*t))*np.sin(np.pi*t/duration)
+    elif name == 'm5_door':
+        x = .065*low*np.sin(np.pi*t/duration)
+        q = np.maximum(t-.68,0); hit = (t>=.68)
+        x += hit*(.24*np.sin(2*np.pi*95*q)*np.exp(-q*22)+.13*noise*np.exp(-q*45))
+        x += hit*.055*np.sin(2*np.pi*340*q)*np.exp(-q*10)
+    elif name == 'm5_laser_switch':
+        x = (.20*noise+.10*np.sin(2*np.pi*1800*t))*np.exp(-t*90)
+    else:
+        # Short filtered squelch, only at radio connection/disconnection.
+        x = .07*(noise-low)*np.sin(np.pi*t/duration)**2
+        x += .08*np.sin(2*np.pi*(1350 if name=='m5_radio_open' else 920)*t)*np.exp(-t*65)
+    x *= _fade(t,duration,.001,.055)
+    pcm = np.column_stack((x,x))
+    # Quiet early reflection rather than a long reverberant smear under speech.
+    delay = round(.047*RATE)
+    pcm[delay:,1] += x[:-delay]*.12
+    pcm *= _fade(t,duration,.001,.055)[:,None]
+    pcm[0] = 0.; pcm[-1] = 0.
+    return pcm
+
+
+GENERATORS = [(name, lambda name=name: _wav(stem_pcm(name))) for name in STEMS]
+GENERATORS += [(name, lambda name=name: _wav(foley_pcm(name))) for name in FOLEY]
+
+
+class FinaleAudio:
+    """Own only this scene's channels; never pause/stop unrelated audio or VO."""
+    def __init__(self, manager):
+        self.manager = manager
+        self.channels = {}
+        self.foley_channels = []
+        self.started = False
+        self.closed = False
+        self.paused = False
+        self.last_ms = None
+        self.seek_sounds = []
+
+    def prepare(self):
+        for name in STEMS + FOLEY:
+            self.manager.get_sound(name)
+
+    def track(self, channel):
+        if channel is not None:
+            self.foley_channels.append((channel, channel.get_sound()))
+
+    def update(self, elapsed_ms):
+        from missions.m5.finale_script import DURATION_MS
+        if self.closed or self.paused:
+            return
+        # Prune finished one-shots to avoid pausing reused automatic channels.
+        self.foley_channels = [(c, s) for c, s in self.foley_channels
+                               if c.get_busy() and c.get_sound() is s]
+        if elapsed_ms >= DURATION_MS:
+            self.stop()
+            return
+        seek = self.last_ms is not None and abs(elapsed_ms-self.last_ms) > 750
+        if not self.started or seek:
+            for ch in self.channels.values():
+                ch.stop()
+            self.channels.clear()
+            self.seek_sounds.clear()
+            self.started = True
+            for name in STEMS:
+                sound = self.manager.get_sound(name)
+                if sound is None:
+                    continue  # Silent/no-device mode still completes the film.
+                if elapsed_ms > 100:
+                    # Re-anchor continuous stems after a suspended window or
+                    # late entry; never replay the opening or missed foley.
+                    import pygame
+                    a = max(0, round(elapsed_ms*RATE/1000))
+                    try:
+                        sound = pygame.mixer.Sound(io.BytesIO(_wav(stem_pcm(name)[a:])))
+                    except pygame.error:
+                        continue
+                    self.seek_sounds.append(sound)
+                sound.set_volume(1.)
+                ch = sound.play()
+                if ch is not None:
+                    self.channels[name] = ch
+            # Retry a missing free channel on the next frame, not every asset.
+            self.started = len(self.channels) == len(STEMS)
+        self.last_ms = elapsed_ms
+        for name, ch in self.channels.items():
+            master = self.manager.master_volume
+            scale = (getattr(self.manager,'_current_music_vol',.5) if name==STEMS[1]
+                     else self.manager.sfx_volume)
+            ch.set_volume(max(0.,min(1.,master*scale)))
+
+    def pause(self):
+        self.paused = True
+        for ch in list(self.channels.values()) + [c for c, s in self.foley_channels
+                                               if c.get_sound() is s]:
+            if ch.get_busy():
+                ch.pause()
+
+    def resume(self):
+        self.paused = False
+        for ch in list(self.channels.values()) + [c for c, s in self.foley_channels
+                                               if c.get_sound() is s]:
+            ch.unpause()
+
+    def stop(self):
+        if self.closed:
+            return
+        self.closed = True
+        for ch in list(self.channels.values()) + [c for c, s in self.foley_channels
+                                               if c.get_sound() is s]:
+            ch.stop()
+        self.channels.clear()
+        self.foley_channels.clear()
+        self.seek_sounds.clear()
